# JobGuard AI - Environment Variables Configuration
APP_NAME="JobGuard AI"
APP_VERSION="1.0.0"
API_PREFIX="/api"

# Security Secrets (Generate a 32+ character random string for production)
SECRET_KEY="jobguard-super-secure-cybersecurity-secret-key-2026-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (SQLite by default, easily swapped with PostgreSQL)
# Example for PostgreSQL: postgresql://user:password@localhost:5432/jobguard_db
DATABASE_URL="sqlite:///./jobguard.db"

# Storage Directories
UPLOAD_DIR="./uploads"
MODEL_DIR="./ml/model_artifacts"
